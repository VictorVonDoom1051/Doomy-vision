{
  "name": "doomy-vision-backend",
  "version": "0.1.0",
  "description": "Doomy Vision API (/api/doomy-vision/v1) - isolated backend bridging Ray-Ban Meta glasses to Doomy Core. Does not modify or depend on other Doomy services at runtime; talks to them only through documented interfaces.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/real-provider-smoke-test.mjs",
    "smoke:pipeline": "node scripts/real-pipeline-smoke-test.mjs",
    "e2e": "node tests/manual_e2e_simulator.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
