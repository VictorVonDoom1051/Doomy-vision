# ==========================================================================
# Doomy Vision Backend — .env.example
# Copiar a .env para desarrollo local. NUNCA commitear .env real.
# En Railway: configurar como variables de entorno del servicio, nunca
# copiar valores reales a este repo.
# ==========================================================================

# --- Servidor ---
PORT=8090
NODE_ENV=development

# --- Modo mock (permite probar todo el flujo sin llaves reales) ---
# Si es true, LLM/STT/TTS usan proveedores simulados deterministas.
DOOMY_VISION_MOCK_MODE=true

# --- Autenticación Bridge -> Doomy Vision ---
# Mismo patrón que DOOMY_WHATSAPP_INTERNAL_KEY ya usado en doomy-assistant:
# un secreto compartido para registrar un device y obtener un access token
# de corta duración (JWT). Generar con: openssl rand -hex 32
DOOMY_VISION_INTERNAL_KEY=changeme-shared-secret
DOOMY_VISION_JWT_SECRET=changeme-jwt-signing-secret
DOOMY_VISION_ACCESS_TOKEN_TTL_MIN=60

# --- Doomy Core (para cuando Doomy Vision se reintegre en doomy-assistant) ---
DOOMY_CORE_URL=https://doomy-assistant-production.up.railway.app
DOOMY_CORE_INTERNAL_KEY=

# --- Proveedores de IA (reutilizar las mismas llaves que doomy-assistant) ---
ANTHROPIC_API_KEY=
DOOMY_VISION_LLM_MODEL=claude-sonnet-5

GROQ_API_KEY=
DOOMY_VISION_STT_MODEL=whisper-large-v3-turbo

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DOOMY_VISION_TTS_MODEL=eleven_flash_v2_5

# --- Límites (feature-flagged, nunca hardcodeados en el código) ---
VISION_MAX_IMAGE_MB=6
VISION_MAX_LONG_EDGE_PX=1280
VISION_JPEG_QUALITY=78
AUDIO_MAX_SECONDS=30
AUDIO_MAX_MB=10
REQUEST_TIMEOUT_MS=20000
SESSION_TTL_MINUTES=60
SESSION_LAST_IMAGE_TTL_MINUTES=15
RATE_LIMIT_MAX_PER_MINUTE=60
# Límite diferenciado para /vision y /audio/* (subida directa de archivos
# pesados) — más estricto que el general por defecto.
RATE_LIMIT_VISION_AUDIO_MAX_PER_MINUTE=30
# Fase 20 (Mission 002) — límites de costo explícitos adicionales.
MAX_RESPONSE_TOKENS=1024
MAX_CONVERSATION_HISTORY=12

# --- CORS (Fase 37) ---
# Vacío = abierto (default, correcto para desarrollo/simulador interno).
# En producción, si algún cliente basado en navegador (no el Bridge nativo)
# necesita llamar directo al backend, fijar una lista separada por comas:
# CORS_ALLOWED_ORIGINS=https://app.doomy.example,https://otro.example
CORS_ALLOWED_ORIGINS=

# --- Escape hatch explícito (Fase 20) ---
# NODE_ENV=production + DOOMY_VISION_MOCK_MODE=true simultáneos bloquean el
# arranque por defecto (probable error de configuración). Fijar en true
# SOLO si es intencional (p. ej. un staging con NODE_ENV=production).
ALLOW_MOCK_IN_PRODUCTION=false

# --- Testing con proveedores reales (NUNCA activar en CI/automatizado) ---
# Si es true, `npm run smoke` (scripts/real-provider-smoke-test.mjs) y
# `npm run smoke:pipeline` (scripts/real-pipeline-smoke-test.mjs) pueden
# ejecutar — sin este flag, ambos se niegan a correr. El primero hace como
# mucho 1 llamada real por proveedor configurado; el segundo ejercita
# /device/register -> /session -> /conversation contra un backend en marcha
# (DOOMY_VISION_API_BASE, default http://localhost:8090) con fixtures de
# imagen/audio generadas en memoria, nunca archivos externos. Ninguno de los
# dos corre en `npm test` ni en CI.
RUN_REAL_PROVIDER_TESTS=false

# --- Feature flags ---
VISION_ENABLED=true
REALTIME_ENABLED=false
TTS_ENABLED=true
DIAGNOSTICS_ENABLED=true
TOOL_CALLING_VISION_ENABLED=false
